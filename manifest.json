{
    "manifest_version": 3,
    "name": "Scientific Calculator",
    "version": "2.3.6",
    "author": "Raad Altaie",
    "description": "Awesome Scientific Calculator for your browser",
    "action": {
        "default_title": "Calculator",
        "default_popup": "popup.html",
        "default_icon": "imgs/icon.png"
    },
    "options_page": "options.html",
    "options_ui": {
        "page": "options.html",
        "open_in_tab": true
    },
    "icons": {
        "128": "imgs/icon.png"
    },
    "permissions": [
        "contextMenus",
        "storage",
        "system.display"
    ],
    "optional_permissions": [
        "scripting",
        "clipboardRead"
    ],
    "storage": {
        "managed_schema": "managed_schema.json"
    },
    "optional_host_permissions": [
        "http://*/*",
        "https://*/*"
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "imgs/icon128.png"
            ],
            "matches": [
                "http://*/*",
                "https://*/*"
            ]
        }
    ],
    "background": {
        "service_worker": "js/background.js"
    },
    "commands": {
        "open_popup": {
            "suggested_key": {
                "default": "Alt+S",
                "windows": "Alt+S",
                "mac": "Alt+S",
                "chromeos": "Alt+S",
                "linux": "Alt+S"
            },
            "description": "Open Scientific Calculator"
        }
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self';"
    }
}